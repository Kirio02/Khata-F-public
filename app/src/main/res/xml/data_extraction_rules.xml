<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Same items as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="ghanshyam_billing_prefs.xml" />
        <include domain="file" path="shop_logo.jpg" />
    </cloud-backup>
    <device-transfer>
        <!-- Phone-to-phone transfer has no 25 MB limit, so photos can come along too -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="ghanshyam_billing_prefs.xml" />
        <include domain="file" path="shop_logo.jpg" />
        <include domain="file" path="attachments/" />
    </device-transfer>
</data-extraction-rules>
